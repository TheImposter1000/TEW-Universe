<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TEWUniverse.Studio</AssemblyName>
    <RootNamespace>TEWUniverse.Desktop</RootNamespace>
    <ApplicationIcon>..\TEWUniverse.Studio\Brand\app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Data.OleDb" Version="8.0.0"/>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0"/>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\TEWUniverse.Studio\DatabaseSession.cs" Link="Services\DatabaseSession.cs"/>
    <Compile Include="..\TEWUniverse.Studio\WorkerExtrasSession.cs" Link="Services\WorkerExtrasSession.cs"/>
    <Compile Include="..\TEWUniverse.Studio\StudioDateFormat.cs" Link="Services\StudioDateFormat.cs"/>
    <Compile Include="..\TEWUniverse.Studio\AppSettings.cs" Link="Services\AppSettings.cs"/>
    <Compile Include="..\TEWUniverse.Studio\CredentialStore.cs" Link="Services\CredentialStore.cs"/>
    <Compile Include="..\TEWUniverse.Studio\UpdateService.cs" Link="Services\UpdateService.cs"/>
  </ItemGroup>
</Project>
