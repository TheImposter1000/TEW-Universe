<Window x:Class="TEWUniverse.Desktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings | TEW Universe Studio" Width="900" Height="650"
        MinWidth="740" MinHeight="530" WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrushLight}"
        FontFamily="Segoe UI">
  <Grid Margin="25">
    <Grid.RowDefinitions>
      <RowDefinition Height="60"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="68"/>
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0">
      <TextBlock Text="Database settings" FontSize="23" FontWeight="Bold"/>
      <TextBlock Text="Locations and credentials stay on your computer, not on GitHub."
                 Foreground="{StaticResource TextBrushMuted}" FontSize="12" Margin="0,5,0,0"/>
    </StackPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="ACTIVE DATABASE  •  DIRECT EDIT" FontSize="12" FontWeight="SemiBold"
                   Foreground="{StaticResource TextBrushMuted}" Margin="0,9,0,8"/>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="95"/></Grid.ColumnDefinitions>
          <TextBox x:Name="ActivePath" Grid.Column="0" Style="{StaticResource FormTextBox}" Margin="0,0,10,0"/>
          <Button Grid.Column="1" Style="{StaticResource ActionButton}" Content="Browse" Click="ActiveBrowse_Click"/>
        </Grid>
        <TextBlock Text="Save Changes writes directly to this MDB. Close the TEW IX database editor first. Older working-copy paths are not automatically activated; choose your active database explicitly."
                   Foreground="#EFC184" Margin="0,7,0,20" TextWrapping="Wrap"/>

        <TextBlock Text="BACKUP FOLDER  •  ON DEMAND" FontSize="12" FontWeight="SemiBold"
                   Foreground="{StaticResource TextBrushMuted}" Margin="0,0,0,8"/>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="95"/></Grid.ColumnDefinitions>
          <TextBox x:Name="BackupPath" Grid.Column="0" Style="{StaticResource FormTextBox}" Margin="0,0,10,0"/>
          <Button Grid.Column="1" Style="{StaticResource ActionButton}" Content="Browse" Click="BackupBrowse_Click"/>
        </Grid>
        <TextBlock Text="Only Create Backup writes snapshots here. Leave blank to use a Backups folder beside the active database."
                   Foreground="{StaticResource TextBrushMuted}" Margin="0,7,0,18" TextWrapping="Wrap"/>
        <TextBlock Text="WORKER PICTURE FOLDER  •  READ ONLY" FontSize="12" FontWeight="SemiBold"
                   Foreground="{StaticResource TextBrushMuted}" Margin="0,0,0,8"/>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="95"/></Grid.ColumnDefinitions>
          <TextBox x:Name="PicturePath" Grid.Column="0" Style="{StaticResource FormTextBox}" Margin="0,0,10,0"/>
          <Button Grid.Column="1" Style="{StaticResource ActionButton}" Content="Browse" Click="PictureBrowse_Click"/>
        </Grid>
        <TextBlock Text="Choose your TEW IX People picture directory. Pictures are matched by worker name, with PNG preferred. Image files are not modified."
                   Foreground="{StaticResource TextBrushMuted}" Margin="0,7,0,18" TextWrapping="Wrap"/>
        <CheckBox x:Name="RememberPassword" Content="Remember database password for this Windows user"
                  Foreground="{StaticResource TextBrushLight}" FontSize="14" Margin="0,4,0,8"/>
        <TextBlock Text="Optional Windows DPAPI encryption. Unchecking removes the locally encrypted credential."
                   Foreground="{StaticResource TextBrushMuted}" TextWrapping="Wrap"/>
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
      <Button Content="Cancel" Style="{StaticResource ActionButton}" Click="Cancel_Click" Width="120" Margin="0,0,10,0"/>
      <Button Content="Save Settings" Style="{StaticResource BlueButton}" Click="Save_Click" Width="155"/>
    </StackPanel>
  </Grid>
</Window>
