<Window x:Class="TEWUniverse.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TEW Universe Studio | TEW IX"
        Width="1540" Height="930" MinWidth="1150" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBrush}"
        FontFamily="Segoe UI" Foreground="{StaticResource TextBrushLight}"
        Closing="MainWindow_Closing">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="55"/>
      <RowDefinition Height="87"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="37"/>
    </Grid.RowDefinitions>

    <!-- Brand strip and current database -->
    <Border Grid.Row="0" Background="#101E2F" BorderBrush="#334964" BorderThickness="0,0,0,1">
      <Grid Margin="19,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Width="29" Height="29" Background="#147CF0" CornerRadius="7" VerticalAlignment="Center">
          <TextBlock Text="U" FontWeight="Bold" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Border>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="13,0,0,0">
          <TextBlock Text="TEW Universe Studio" FontSize="21" FontWeight="Bold"/>
          <TextBlock Text="  |  TEW IX" FontSize="15" Foreground="{StaticResource TextBrushMuted}" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock Grid.Column="2" x:Name="ProjectPathLabel" Text="No working database open"
                   Foreground="{StaticResource TextBrushMuted}" FontSize="12"
                   TextTrimming="CharacterEllipsis" Margin="26,0,0,0" VerticalAlignment="Center"/>
      </Grid>
    </Border>

    <!-- Main commands; horizontal scrollbar avoids clipped commands on smaller screens -->
    <Border Grid.Row="1" Background="#101B2B" BorderBrush="#334964" BorderThickness="0,0,0,1">
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,11,15,7">
          <Button x:Name="ImportButton" Style="{StaticResource ActionButton}" Click="Import_Click" Margin="0,0,9,0">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="▤" Foreground="#32A3FF" FontSize="23" Margin="0,0,12,0"/>
              <StackPanel>
                <TextBlock Text="Import Database" FontWeight="SemiBold"/>
                <TextBlock Text="Create a new working copy" FontWeight="Normal" FontSize="10" Foreground="{StaticResource TextBrushMuted}"/>
              </StackPanel>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource ActionButton}" Click="OpenProject_Click" Margin="0,0,9,0">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="▣" Foreground="#F5BC4C" FontSize="23" Margin="0,0,12,0"/>
              <StackPanel>
                <TextBlock Text="Open Project" FontWeight="SemiBold"/>
                <TextBlock Text="Use saved working copy" FontWeight="Normal" FontSize="10" Foreground="{StaticResource TextBrushMuted}"/>
              </StackPanel>
            </StackPanel>
          </Button>
          <Button x:Name="SaveButton" Style="{StaticResource BlueButton}" Click="Save_Click" IsEnabled="False" Margin="0,0,9,0">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="▣" FontSize="24" Margin="0,0,12,0"/>
              <StackPanel>
                <TextBlock Text="Save Changes" FontWeight="SemiBold"/>
                <TextBlock Text="Write to working copy" FontWeight="Normal" FontSize="10"/>
              </StackPanel>
            </StackPanel>
          </Button>
          <Button x:Name="BackupButton" Style="{StaticResource BackupButton}" Click="Backup_Click" IsEnabled="False" Margin="0,0,9,0">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="◈" Foreground="#BE9CFF" FontSize="23" Margin="0,0,12,0"/>
              <StackPanel>
                <TextBlock Text="Create Backup" FontWeight="SemiBold"/>
                <TextBlock Text="Snapshot the saved copy" FontWeight="Normal" FontSize="10" Foreground="#C1B0EE"/>
              </StackPanel>
            </StackPanel>
          </Button>
          <Button x:Name="SaveAsButton" Style="{StaticResource ActionButton}" Click="SaveAs_Click" IsEnabled="False" Margin="0,0,9,0">
            <StackPanel>
              <TextBlock Text="Save Copy As..." FontWeight="SemiBold"/>
              <TextBlock Text="New editable database" FontWeight="Normal" FontSize="10" Foreground="{StaticResource TextBrushMuted}"/>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource ActionButton}" Click="Settings_Click" Margin="0,0,9,0">
            <TextBlock Text="⚙  Settings"/>
          </Button>
          <Button x:Name="UpdatesButton" Style="{StaticResource ActionButton}" Click="Updates_Click" Margin="0,0,9,0">
            <TextBlock Text="⟳  Check for Updates"/>
          </Button>
          <Button Style="{StaticResource ActionButton}" Click="UpdateLog_Click">
            <TextBlock Text="⋯  Update log"/>
          </Button>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="175"/>
        <ColumnDefinition Width="305"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Main navigation -->
      <Border Grid.Column="0" Background="#101B2B" BorderBrush="#30435B" BorderThickness="0,0,1,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Bottom" Margin="12,10,12,18">
            <TextBlock Text="PROJECT" Foreground="{StaticResource TextBrushMuted}" Margin="10,0,0,9"/>
            <Button Style="{StaticResource NavigationButton}" Click="OpenProject_Click" Content="▣   Current Project"/>
            <Button Style="{StaticResource NavigationButton}" Click="ProjectsFolder_Click" Content="▣   Project Folder"/>
          </StackPanel>
          <StackPanel Margin="0,11,0,0">
            <Button x:Name="WorkersNav" Style="{StaticResource BlueButton}" Margin="8,4" Click="WorkersNav_Click" Content="♟   Workers"/>
            <Button Style="{StaticResource NavigationButton}" Tag="Companies" Click="FutureNav_Click" Content="▤   Companies"/>
            <Button Style="{StaticResource NavigationButton}" Tag="Titles" Click="FutureNav_Click" Content="♜   Titles"/>
            <Button Style="{StaticResource NavigationButton}" Tag="Events" Click="FutureNav_Click" Content="▦   Events"/>
            <Button Style="{StaticResource NavigationButton}" Tag="Stables" Click="FutureNav_Click" Content="♟   Stables"/>
            <Button Style="{StaticResource NavigationButton}" Tag="Relationships" Click="FutureNav_Click" Content="↔   Relationships"/>
            <Button Style="{StaticResource NavigationButton}" Tag="History" Click="FutureNav_Click" Content="◷   History"/>
            <Button Style="{StaticResource NavigationButton}" Tag="Tools" Click="FutureNav_Click" Content="⚒   Tools"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Worker master list -->
      <Border Grid.Column="1" Margin="10,10,7,10" Style="{StaticResource CardBorder}">
        <DockPanel Margin="12">
          <StackPanel DockPanel.Dock="Top" Margin="0,0,0,9">
            <TextBlock Text="Workers" FontSize="20" FontWeight="Bold" Margin="3,0,0,13"/>
            <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" TextChanged="SearchBox_TextChanged"
                     ToolTip="Filter workers by name or ID"/>
            <TextBlock x:Name="WorkerCountText" Text="Open a database to search workers"
                       Foreground="{StaticResource TextBrushMuted}" FontSize="12" Margin="3,12,0,4"/>
          </StackPanel>
          <ListBox x:Name="WorkersList" Background="Transparent" BorderThickness="0"
                   HorizontalContentAlignment="Stretch" SelectionChanged="WorkersList_SelectionChanged"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Height="44">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Border Width="30" Height="30" CornerRadius="15" Background="#2C4B75" VerticalAlignment="Center">
                    <TextBlock Text="●" FontSize="16" Foreground="#B6D6FF"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Id, StringFormat=ID {0}}" Foreground="#AEC4E1" FontSize="11"/>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- Detail editor -->
      <Grid Grid.Column="2" Margin="4,10,11,10">
        <Grid.RowDefinitions>
          <RowDefinition Height="124"/>
          <RowDefinition Height="52"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Background="#17283E" Padding="16" Margin="0,0,0,9">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="83"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Width="69" Height="69" CornerRadius="35" Background="#2C486D" VerticalAlignment="Center">
              <TextBlock Text="●" Foreground="#A6C5EF" FontSize="43"
                         VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock x:Name="WorkerNameText" Text="Choose an existing worker"
                         FontSize="24" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="WorkerSummaryText" Text="Search on the left to open a worker profile."
                         Foreground="{StaticResource TextBrushMuted}" Margin="0,9,0,0" FontSize="13"
                         TextWrapping="Wrap"/>
            </StackPanel>
            <Border Grid.Column="2" Background="#173F50" CornerRadius="15"
                    VerticalAlignment="Top" Padding="12,6">
              <TextBlock x:Name="WorkerStatusText" Text="No record" Foreground="#6DE6C1" FontSize="12"/>
            </Border>
          </Grid>
        </Border>

        <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,9">
          <Button x:Name="ProfileTab" Style="{StaticResource BlueButton}" Content="Profile" Tag="Profile" Click="Tab_Click" Margin="0,0,5,0"/>
          <Button x:Name="SkillsTab" Style="{StaticResource ActionButton}" Content="Skills" Tag="Skills" Click="Tab_Click" Margin="0,0,5,0"/>
          <Button x:Name="PopularityTab" Style="{StaticResource ActionButton}" Content="Popularity" Tag="Popularity" Click="Tab_Click" Margin="0,0,5,0"/>
          <Button x:Name="PhysicalTab" Style="{StaticResource ActionButton}" Content="Physical" Tag="Physical" Click="Tab_Click" Margin="0,0,5,0"/>
          <Button x:Name="BiographyTab" Style="{StaticResource ActionButton}" Content="Biography" Tag="Biography" Click="Tab_Click"/>
        </UniformGrid>

        <Grid Grid.Row="2">
          <!-- Profile + biography and facts -->
          <Grid x:Name="ProfileView">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1.08*"/>
              <ColumnDefinition Width="0.92*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,6,0">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Basic Information" Margin="17,15,10,12"
                           FontWeight="Bold" FontSize="16"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel x:Name="ProfileFieldsPanel" Margin="15,0,15,16"/>
                </ScrollViewer>
              </DockPanel>
            </Border>
            <Grid Grid.Column="1" Margin="6,0,0,0">
              <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="1*"/>
              </Grid.RowDefinitions>
              <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,0,8">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Biography / Notes" FontSize="16" FontWeight="Bold" Margin="2,0,0,10"/>
                  </StackPanel>
                  <TextBox x:Name="BioEditor" Style="{StaticResource FormTextBox}"
                           AcceptsReturn="True" TextWrapping="Wrap"
                           VerticalScrollBarVisibility="Auto"
                           VerticalContentAlignment="Top"
                           TextChanged="BioEditor_TextChanged"/>
                </DockPanel>
              </Border>
              <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="15" Margin="0,8,0,0">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Top" Text="Quick Facts" FontSize="16" FontWeight="Bold"
                             Margin="0,0,0,11"/>
                  <StackPanel>
                    <TextBlock x:Name="QuickId" Text="Worker ID: —" FontSize="12" Margin="0,0,0,7"/>
                    <TextBlock x:Name="QuickActive" Text="Status: —" FontSize="12" Margin="0,0,0,7"/>
                    <TextBlock x:Name="QuickDatabase" Text="Current Copy: —" FontSize="12"
                               TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                </DockPanel>
              </Border>
            </Grid>
          </Grid>

          <!-- Skills, popularity and physical values -->
          <Border x:Name="DetailsView" Visibility="Collapsed" Style="{StaticResource CardBorder}">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" Margin="17,15,17,7">
                <TextBlock x:Name="DetailsTitle" Text="Database fields" FontSize="19" FontWeight="Bold"/>
                <TextBlock x:Name="DetailsSubtitle"
                           Text="Values are read from the selected TEW IX database."
                           Foreground="{StaticResource TextBrushMuted}" Margin="0,6,0,0" TextWrapping="Wrap"/>
              </StackPanel>
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="DetailsFieldsPanel" Margin="17,0,17,17"/>
              </ScrollViewer>
            </DockPanel>
          </Border>

          <Border x:Name="BiographyView" Visibility="Collapsed" Style="{StaticResource CardBorder}" Padding="18">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="Biography / Notes" FontSize="19"
                         FontWeight="Bold" Margin="0,0,0,14"/>
              <TextBox x:Name="FullBioEditor" Style="{StaticResource FormTextBox}"
                       AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                       VerticalScrollBarVisibility="Auto" TextChanged="FullBioEditor_TextChanged"/>
            </DockPanel>
          </Border>
        </Grid>
      </Grid>
    </Grid>

    <Border Grid.Row="3" Background="#101B2B" BorderBrush="#30435B" BorderThickness="0,1,0,0">
      <Grid Margin="16,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusText" Text="Ready" Foreground="#65DEC3"
                   FontSize="12" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" x:Name="FilteredText" Text=""
                   Foreground="{StaticResource TextBrushMuted}" FontSize="12"
                   VerticalAlignment="Center" Margin="20,0"/>
        <TextBlock Grid.Column="2" x:Name="WorkingText" Text="No working copy"
                   Foreground="{StaticResource TextBrushMuted}" FontSize="12"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        <TextBlock Grid.Column="3" x:Name="SaveStateText" Text="No unsaved edits"
                   Foreground="#70E4C6" FontSize="12" VerticalAlignment="Center"/>
      </Grid>
    </Border>
  </Grid>
</Window>