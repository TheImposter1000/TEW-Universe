<Window x:Class="TEWUniverse.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:TEWUniverse.Desktop"
        Title="TEW Universe Studio | TEW IX"
        Width="1580" Height="930" MinWidth="1150" MinHeight="700" WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBrush}"
        FontFamily="Segoe UI" Foreground="{StaticResource TextBrushLight}"
        Closing="MainWindow_Closing">
  <Window.Resources>
    <local:WorkerPortraitConverter x:Key="WorkerPictureConverter"/>
  </Window.Resources>
  <shell:WindowChrome.WindowChrome>
   <shell:WindowChrome CaptionHeight="54" GlassFrameThickness="0" ResizeBorderThickness="7" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="55"/>
      <RowDefinition Height="87"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="37"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#102139" BorderBrush="#34516E" BorderThickness="0,0,0,1">
     <Grid Margin="18,0,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="138"/></Grid.ColumnDefinitions>
      <Border Width="29" Height="29" Background="#147AF1" CornerRadius="6" VerticalAlignment="Center">
       <TextBlock Text="◈" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="13,0,0,0">
       <TextBlock Text="TEW Universe Studio" FontSize="21" FontWeight="Bold"/>
       <TextBlock Text="  |  TEW IX" FontSize="14" Foreground="#90ACD0" VerticalAlignment="Center"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,12,0">
       <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,10,0" Foreground="#AFCBEA"/>
       <TextBlock x:Name="ProjectPathLabel" Text="No active database open"
        Foreground="#A7BDDA" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
      </StackPanel>
      <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right">
       <Button Width="46" Height="48" Background="Transparent" BorderThickness="0"
        shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Minimize_Click" ToolTip="Minimize">
        <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
       </Button>
       <Button Width="46" Height="48" Background="Transparent" BorderThickness="0"
        shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Maximize_Click" ToolTip="Maximize or restore">
        <TextBlock x:Name="MaximizeGlyph" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
       </Button>
       <Button Width="46" Height="48" Background="Transparent" BorderThickness="0"
        shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click" ToolTip="Close">
        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
       </Button>
      </StackPanel>
     </Grid>
    </Border>

    <!-- Main commands; horizontal scrollbar avoids clipped commands on smaller screens -->
    <Border Grid.Row="1" Background="#101B2B" BorderBrush="#334964" BorderThickness="0,0,0,1">
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,11,15,7">
          <Button x:Name="ImportButton" Style="{StaticResource ActionButton}" Click="Import_Click" Margin="0,0,9,0">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Foreground="#32A3FF" FontSize="23" Margin="0,0,12,0"/>
              <StackPanel>
                <TextBlock Text="Select Database" FontWeight="SemiBold"/>
                <TextBlock Text="Edit this MDB directly" FontWeight="Normal" FontSize="10" Foreground="{StaticResource TextBrushMuted}"/>
              </StackPanel>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource ActionButton}" Click="RefreshDatabase_Click" Margin="0,0,9,0">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" Foreground="#F5BC4C" FontSize="23" Margin="0,0,12,0"/>
              <StackPanel>
                <TextBlock Text="Refresh Database" FontWeight="SemiBold"/>
                <TextBlock Text="Reload external changes" FontWeight="Normal" FontSize="10" Foreground="{StaticResource TextBrushMuted}"/>
              </StackPanel>
            </StackPanel>
          </Button>
          <Button x:Name="SaveButton" Style="{StaticResource BlueButton}" Click="Save_Click" IsEnabled="False" Margin="0,0,9,0">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="24" Margin="0,0,12,0"/>
              <StackPanel>
                <TextBlock Text="Save Changes" FontWeight="SemiBold"/>
                <TextBlock Text="Write to active MDB" FontWeight="Normal" FontSize="10"/>
              </StackPanel>
            </StackPanel>
          </Button>
          <Button x:Name="BackupButton" Style="{StaticResource BackupButton}" Click="Backup_Click" IsEnabled="False" Margin="0,0,9,0">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE753;" FontFamily="Segoe MDL2 Assets" Foreground="#BE9CFF" FontSize="23" Margin="0,0,12,0"/>
              <StackPanel>
                <TextBlock Text="Create Backup" FontWeight="SemiBold"/>
                <TextBlock Text="Manual snapshot of active MDB" FontWeight="Normal" FontSize="10" Foreground="#C1B0EE"/>
              </StackPanel>
            </StackPanel>
          </Button>
          <Button x:Name="SaveAsButton" Style="{StaticResource ActionButton}" Click="SaveAs_Click" IsEnabled="False" Margin="0,0,9,0">
            <StackPanel>
              <TextBlock Text="Export Copy As..." FontWeight="SemiBold"/>
              <TextBlock Text="Keep active MDB selected" FontWeight="Normal" FontSize="10" Foreground="{StaticResource TextBrushMuted}"/>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource ActionButton}" Click="Settings_Click" Margin="0,0,9,0">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="18" Margin="0,0,8,0"/><TextBlock Text="Settings" VerticalAlignment="Center"/></StackPanel>
          </Button>
          <Button x:Name="UpdatesButton" Style="{StaticResource ActionButton}" Click="Updates_Click" Margin="0,0,9,0">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="18" Margin="0,0,8,0"/><TextBlock Text="Check for Updates" VerticalAlignment="Center"/></StackPanel>
          </Button>
          <Button Style="{StaticResource ActionButton}" Click="UpdateLog_Click">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="18" Margin="0,0,8,0"/><TextBlock Text="Update log" VerticalAlignment="Center"/></StackPanel>
          </Button>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="210"/>
        <ColumnDefinition Width="345"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Primary navigation -->
      <Border Grid.Column="0" Background="#0D1C30" BorderBrush="#2D4965" BorderThickness="0,0,1,0">
       <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="10,10,10,16">
         <Border BorderBrush="#365371" BorderThickness="0,1,0,0" Margin="8,0,8,18"/>
         <TextBlock Text="PROJECT" Foreground="#8EAACA" FontSize="11" Margin="14,0,0,8"/>
         <Button Style="{StaticResource NavigationButton}" Click="Import_Click">
          <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="18" Width="35"/><TextBlock Text="Select Database"/></StackPanel>
         </Button>
         <Button Style="{StaticResource NavigationButton}" Click="ProjectsFolder_Click">
          <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="18" Width="35"/><TextBlock Text="Database Folder"/></StackPanel>
         </Button>
        </StackPanel>
        <StackPanel Margin="0,8,0,0"><Button x:Name="WorkersNav" Style="{StaticResource BlueButton}" HorizontalContentAlignment="Left" Click="WorkersNav_Click" Margin="9,4" Height="45"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="19" Width="35"/><TextBlock Text="Workers" VerticalAlignment="Center"/></StackPanel></Button>
<Button x:Name="CompaniesNav" Tag="Companies" Style="{StaticResource NavigationButton}" Click="FutureNav_Click" Margin="9,4" Height="45"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="19" Width="35"/><TextBlock Text="Companies" VerticalAlignment="Center"/></StackPanel></Button>
<Button x:Name="TitlesNav" Tag="Titles" Style="{StaticResource NavigationButton}" Click="FutureNav_Click" Margin="9,4" Height="45"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7C1;" FontFamily="Segoe MDL2 Assets" FontSize="19" Width="35"/><TextBlock Text="Titles" VerticalAlignment="Center"/></StackPanel></Button>
<Button x:Name="TagTeamsNav" Tag="Tag Teams" Style="{StaticResource NavigationButton}" Click="FutureNav_Click" Margin="9,4" Height="45"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8D4;" FontFamily="Segoe MDL2 Assets" FontSize="19" Width="35"/><TextBlock Text="Tag Teams" VerticalAlignment="Center"/></StackPanel></Button>
<Button x:Name="EventsNav" Tag="Events" Style="{StaticResource NavigationButton}" Click="FutureNav_Click" Margin="9,4" Height="45"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="19" Width="35"/><TextBlock Text="Events" VerticalAlignment="Center"/></StackPanel></Button>
<Button x:Name="StablesNav" Tag="Stables" Style="{StaticResource NavigationButton}" Click="FutureNav_Click" Margin="9,4" Height="45"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="19" Width="35"/><TextBlock Text="Stables" VerticalAlignment="Center"/></StackPanel></Button>
<Button x:Name="RelationshipsNav" Tag="Relationships" Style="{StaticResource NavigationButton}" Click="FutureNav_Click" Margin="9,4" Height="45"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="19" Width="35"/><TextBlock Text="Relationships" VerticalAlignment="Center"/></StackPanel></Button>
<Button x:Name="AwardsNav" Tag="Awards" Style="{StaticResource NavigationButton}" Click="FutureNav_Click" Margin="9,4" Height="45"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7C1;" FontFamily="Segoe MDL2 Assets" FontSize="19" Width="35"/><TextBlock Text="Awards" VerticalAlignment="Center"/></StackPanel></Button>
<Button x:Name="ToolsNav" Tag="Tools" Style="{StaticResource NavigationButton}" Click="FutureNav_Click" Margin="9,4" Height="45"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE90F;" FontFamily="Segoe MDL2 Assets" FontSize="19" Width="35"/><TextBlock Text="Tools" VerticalAlignment="Center"/></StackPanel></Button></StackPanel>
       </DockPanel>
      </Border>

      <!-- Searchable, sortable worker list -->
      <Border x:Name="WorkerBrowserPanel" Grid.Column="1" Margin="10,10,7,10" Style="{StaticResource CardBorder}">
       <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
         <StackPanel Orientation="Horizontal" Margin="3,4,0,14">
          <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="23"
            Foreground="#BDD7F4" Margin="0,0,12,0"/>
          <TextBlock Text="Workers" FontSize="22" FontWeight="Bold"/>
         </StackPanel>
         <Border Background="#102238" BorderBrush="#3B5673" BorderThickness="1" CornerRadius="6">
          <Grid>
           <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
           <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="15"
            Foreground="#A6C7E8" VerticalAlignment="Center" HorizontalAlignment="Center"/>
           <TextBox x:Name="SearchBox" Grid.Column="1" Style="{StaticResource SearchBox}"
             BorderThickness="0" Background="Transparent" TextChanged="SearchBox_TextChanged"
             ToolTip="Search workers by name or ID"/>
           <Button Grid.Column="2" Background="Transparent" BorderThickness="0"
             Click="ClearSearch_Click" ToolTip="Clear search">
            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#ADC6E3"/>
           </Button>
          </Grid>
         </Border>
         <!-- These are query-only filters; they never modify the MDB. Keep
              the panel collapsed so the worker list remains usable. -->
         <DockPanel Margin="0,10,0,0">
          <Button DockPanel.Dock="Right" Content="Reset" x:Name="WorkerResetFilters"
                  Style="{StaticResource ActionButton}"
                  Click="ResetWorkerFilters_Click" Padding="11,6"
                  ToolTip="Reset all filters (keeps your name search)"/>
          <Button x:Name="WorkerFilterToggle" DockPanel.Dock="Left"
                  Click="WorkerFilterToggle_Click"
                  Style="{StaticResource ActionButton}"
                  HorizontalContentAlignment="Left" Padding="12,7"
                  Margin="0,0,7,0">
           <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE71C;" FontFamily="Segoe MDL2 Assets"
                       Margin="0,0,9,0" Foreground="#B5D5F5"/>
            <TextBlock x:Name="WorkerFilterToggleText" Text="Filters (all)"/>
           </StackPanel>
          </Button>
         </DockPanel>
         <Border x:Name="WorkerFilterPanel" Visibility="Collapsed"
                 Background="#10253D" BorderBrush="#365A7E"
                 BorderThickness="1" CornerRadius="7"
                 Margin="0,8,0,0" Padding="10,9,10,8">
          <ScrollViewer MaxHeight="325" VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
           <StackPanel>
            <TextBlock Text="ROSTER FILTERS" Foreground="#97BEDF"
                       FontSize="11" FontWeight="SemiBold"
                       Margin="0,0,0,9"/>
            <TextBlock Text="Status" Foreground="#ADC9E8" FontSize="11"/>
            <ComboBox x:Name="WorkerActiveFilter" Height="34"
                      Style="{StaticResource DarkComboBox}"
                      SelectionChanged="WorkerFilterChanged" Margin="0,3,0,9"/>
            <TextBlock Text="Gender" Foreground="#ADC9E8" FontSize="11"/>
            <ComboBox x:Name="WorkerGenderFilter" Height="34"
                      Style="{StaticResource DarkComboBox}"
                      SelectionChanged="WorkerFilterChanged" Margin="0,3,0,9"/>
            <TextBlock Text="Age range (years)" Foreground="#ADC9E8" FontSize="11"/>
            <Grid Margin="0,3,0,9">
             <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/>
              <ColumnDefinition Width="*"/>
             </Grid.ColumnDefinitions>
             <TextBox x:Name="WorkerMinAgeFilter" Grid.Column="0"
                      Style="{StaticResource FormTextBox}" Height="34"
                      ToolTip="Minimum age, inclusive (0–120)"
                      TextChanged="WorkerAgeFilterChanged"/>
             <TextBox x:Name="WorkerMaxAgeFilter" Grid.Column="2"
                      Style="{StaticResource FormTextBox}" Height="34"
                      ToolTip="Maximum age, inclusive (0–120)"
                      TextChanged="WorkerAgeFilterChanged"/>
            </Grid>
            <TextBlock x:Name="WorkerAgeFilterHint" Text="Minimum                  Maximum"
                       FontSize="10" Foreground="#819FBB"
                       Margin="0,-7,0,10"/>
            <TextBlock Text="Current company (contract)" Foreground="#ADC9E8" FontSize="11"/>
            <ComboBox x:Name="WorkerCompanyFilter" Height="34"
                      Style="{StaticResource DarkComboBox}"
                      IsTextSearchEnabled="True"
                      SelectionChanged="WorkerFilterChanged" Margin="0,3,0,9"/>
            <TextBlock Text="Worker type / role" Foreground="#ADC9E8" FontSize="11"/>
            <ComboBox x:Name="WorkerRoleFilter" Height="34"
                      Style="{StaticResource DarkComboBox}"
                      SelectionChanged="WorkerFilterChanged" Margin="0,3,0,9"/>
            <TextBlock Text="Nationality" Foreground="#ADC9E8" FontSize="11"/>
            <ComboBox x:Name="WorkerNationalityFilter" Height="34"
                      Style="{StaticResource DarkComboBox}"
                      SelectionChanged="WorkerFilterChanged" Margin="0,3,0,9"/>
            <TextBlock Text="Based in (region)" Foreground="#ADC9E8" FontSize="11"/>
            <ComboBox x:Name="WorkerRegionFilter" Height="34"
                      Style="{StaticResource DarkComboBox}"
                      SelectionChanged="WorkerFilterChanged" Margin="0,3,0,9"/>
            <TextBlock Text="Portraits" Foreground="#ADC9E8" FontSize="11"/>
            <ComboBox x:Name="WorkerPictureFilter" Height="34"
                      Style="{StaticResource DarkComboBox}"
                      SelectionChanged="WorkerFilterChanged" Margin="0,3,0,5"/>
            <TextBlock x:Name="WorkerFilterNotes" Text=""
                       TextWrapping="Wrap" FontSize="10"
                       Foreground="#9EB8D3" Margin="0,6,0,1"/>
           </StackPanel>
          </ScrollViewer>
         </Border>
         <Grid Margin="2,12,2,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="WorkerCountText" Text="No database open"
            Foreground="#A9C1DD" FontSize="11" VerticalAlignment="Center"/>
          <ComboBox Grid.Column="1" x:Name="SortCombo" Style="{StaticResource DarkComboBox}" Height="32"
            SelectionChanged="SortCombo_SelectionChanged" ToolTip="Sort workers">
            <ComboBoxItem Content="Name A to Z" IsSelected="True"/>
            <ComboBoxItem Content="Name Z to A"/>
            <ComboBoxItem Content="Worker ID"/>
          </ComboBox>
         </Grid>
        </StackPanel>
        <ListBox x:Name="WorkersList" Background="Transparent" BorderThickness="0"
         HorizontalContentAlignment="Stretch" SelectionChanged="WorkersList_SelectionChanged"
         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
         VirtualizingStackPanel.IsVirtualizing="True"
         VirtualizingStackPanel.VirtualizationMode="Recycling">
         <ListBox.ItemTemplate>
          <DataTemplate>
           <Grid Height="56">
            <Grid.ColumnDefinitions>
             <ColumnDefinition Width="43"/><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/>
            </Grid.ColumnDefinitions>
            <Grid Width="36" Height="36" VerticalAlignment="Center">
             <Border CornerRadius="18"
               Background="{Binding Converter={StaticResource WorkerPictureConverter}, ConverterParameter=PlaceholderBackground}">
              <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="19"
               Foreground="#B5D5F5" HorizontalAlignment="Center" VerticalAlignment="Center"
               Visibility="{Binding Converter={StaticResource WorkerPictureConverter}, ConverterParameter=PlaceholderVisibility}"/>
             </Border>
             <Ellipse Fill="{Binding Converter={StaticResource WorkerPictureConverter}}"
                      Width="36" Height="36"/>
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
             <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
             <TextBlock Text="{Binding Id, StringFormat=ID {0}}" Foreground="#B9CFE9" FontSize="11"/>
            </StackPanel>
            <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets"
               FontSize="11" VerticalAlignment="Center" Foreground="#B6D4F5"/>
           </Grid>
          </DataTemplate>
         </ListBox.ItemTemplate>
        </ListBox>
       </DockPanel>
      </Border>

      <!-- Detail editor -->
      <Grid x:Name="WorkerDetailPanel" Grid.Column="2" Margin="4,10,11,10">
        <Grid.RowDefinitions>
          <RowDefinition Height="149"/>
          <RowDefinition Height="96"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Profile banner with live facts, no fabricated metadata -->
        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="17" Margin="0,0,0,9">
         <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
           <GradientStop Color="#19324A" Offset="0"/>
           <GradientStop Color="#133D67" Offset="0.73"/>
           <GradientStop Color="#202D60" Offset="1"/>
          </LinearGradientBrush>
         </Border.Background>
         <Grid>
          <Grid.ColumnDefinitions>
           <ColumnDefinition Width="96"/>
           <ColumnDefinition Width="*"/>
           <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Grid Width="79" Height="79" VerticalAlignment="Center">
           <Border x:Name="WorkerPortraitPlaceholder" CornerRadius="40" Background="#2E4C70"
            BorderBrush="#91AECC" BorderThickness="1">
            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="46"
             Foreground="#BFD7F3" HorizontalAlignment="Center" VerticalAlignment="Center"/>
           </Border>
           <Ellipse x:Name="WorkerPortraitEllipse" Width="79" Height="79" Fill="Transparent"
                    ToolTip="Portrait matched by worker name"/>
          </Grid>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
           <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="WorkerNameText" Text="Choose an existing worker"
             FontSize="26" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
            <Border Background="#1B426B" BorderBrush="#47729C" BorderThickness="1"
             CornerRadius="5" Margin="13,4,0,0" Padding="10,5">
             <TextBlock x:Name="WorkerIdBadge" Text="Worker ID —" FontSize="11" Foreground="#BBD8F8"/>
            </Border>
           </StackPanel>
           <WrapPanel x:Name="HeaderFactsPanel" Margin="0,12,0,0">
            <TextBlock x:Name="WorkerSummaryText" Text="Select a worker to view verified database details."
              FontSize="12" Foreground="#C3D8F2"/>
           </WrapPanel>
          </StackPanel>
          <Border Grid.Column="2" Background="#0D4B52" BorderBrush="#149E98"
            BorderThickness="1" CornerRadius="18" Padding="13,7" VerticalAlignment="Top">
           <TextBlock x:Name="WorkerStatusText" Text="No record" Foreground="#70F2D6" FontSize="12"/>
          </Border>
         </Grid>
        </Border>

        <UniformGrid Grid.Row="1" Columns="3" Rows="3" Margin="0,0,0,9">
          <Button x:Name="ProfileTab" Style="{StaticResource BlueButton}" Content="▣   Profile" Tag="Profile" Click="Tab_Click" Margin="0,0,5,0"/>
          <Button x:Name="SkillsTab" Style="{StaticResource ActionButton}" Content="▥   Skills" Tag="Skills" Click="Tab_Click" Margin="0,0,5,0"/>
          <Button x:Name="PopularityTab" Style="{StaticResource ActionButton}" Content="★   Popularity" Tag="Popularity" Click="Tab_Click" Margin="0,0,5,0"/>
          <Button x:Name="PhysicalTab" Style="{StaticResource ActionButton}" Content="⚑   Physical" Tag="Physical" Click="Tab_Click" Margin="0,0,5,0"/>
          <Button x:Name="BiographyTab" Style="{StaticResource ActionButton}" Content="▣   Biography" Tag="Biography" Click="Tab_Click"/>
           <Button x:Name="AttributesTab" Style="{StaticResource ActionButton}"
                   Content="◆   Attributes" Tag="Attributes" Click="Tab_Click" Margin="0,0,5,0"/>
           <Button x:Name="ContractsTab" Style="{StaticResource ActionButton}"
                   Content="▤   Contracts" Tag="Contracts" Click="Tab_Click" Margin="0,0,5,0"/>
           <Button x:Name="EmploymentTab" Style="{StaticResource ActionButton}"
                   Content="▣   Employment History" Tag="Employment" Click="Tab_Click"/>
           <Button x:Name="AccomplishmentsTab" Style="{StaticResource ActionButton}"
                   Content="★   Accomplishments" Tag="Accomplishments" Click="Tab_Click" Margin="0,0,5,0"/>
        </UniformGrid>

        <Grid Grid.Row="2">
          <!-- Profile + biography and facts -->
          <Grid x:Name="ProfileView">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1.02*"/>
              <ColumnDefinition Width="0.98*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,6,0">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="●   Basic Information" Margin="17,16,10,14"
                           FontWeight="Bold" FontSize="17"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel x:Name="ProfileFieldsPanel" Margin="17,0,17,18"/>
                </ScrollViewer>
              </DockPanel>
            </Border>
            <Grid Grid.Column="1" Margin="6,0,0,0">
              <Grid.RowDefinitions>
                <RowDefinition Height="1.4*"/>
                <RowDefinition Height="1*"/>
              </Grid.RowDefinitions>
              <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,0,8">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="▣   Biography / Notes" FontSize="17" FontWeight="Bold" Margin="2,0,0,12"/>
                  </StackPanel>
                  <TextBlock x:Name="BioCountText" DockPanel.Dock="Bottom" HorizontalAlignment="Right"
                   Text="0 characters" Margin="0,9,2,0" Foreground="#9CB8D9" FontSize="11"/>
                <TextBox x:Name="BioEditor" Style="{StaticResource FormTextBox}"
                           AcceptsReturn="True" TextWrapping="Wrap"
                           VerticalScrollBarVisibility="Auto"
                           VerticalContentAlignment="Top"
                           TextChanged="BioEditor_TextChanged"/>
                </DockPanel>
              </Border>
              <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="15" Margin="0,8,0,0">
               <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="▥   Quick Facts" FontSize="17"
                 FontWeight="Bold" Margin="0,0,0,11"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                 <UniformGrid x:Name="QuickFactsPanel" Columns="2"/>
                </ScrollViewer>
               </DockPanel>
              </Border>
            </Grid>
          </Grid>

          <!-- Skills, popularity and physical values -->
          <Border x:Name="DetailsView" Visibility="Collapsed" Style="{StaticResource CardBorder}">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" Margin="17,15,17,7">
                <TextBlock x:Name="DetailsTitle" Text="Database fields" FontSize="19" FontWeight="Bold"/>
                <TextBlock x:Name="DetailsSubtitle"
                           Text="Values are read from the selected TEW IX database."
                           Foreground="{StaticResource TextBrushMuted}" Margin="0,6,0,0" TextWrapping="Wrap"/>
              </StackPanel>
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="DetailsFieldsPanel" Margin="17,0,17,17"/>
              </ScrollViewer>
            </DockPanel>
          </Border>
           <Border x:Name="AttributesView" Visibility="Collapsed"
                   Style="{StaticResource CardBorder}" Padding="14">
            <Grid x:Name="AttributesHost"/>
           </Border>
           <Border x:Name="ContractsView" Visibility="Collapsed"
                   Style="{StaticResource CardBorder}" Padding="14">
            <Grid x:Name="ContractsHost"/>
           </Border>
           <Border x:Name="EmploymentView" Visibility="Collapsed"
                   Style="{StaticResource CardBorder}" Padding="14">
            <Grid x:Name="EmploymentHost"/>
           </Border>
           <Border x:Name="AccomplishmentsView" Visibility="Collapsed"
                   Style="{StaticResource CardBorder}" Padding="14">
            <Grid x:Name="AccomplishmentsHost"/>
           </Border>
           

          <Border x:Name="BiographyView" Visibility="Collapsed" Style="{StaticResource CardBorder}" Padding="18">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="Biography / Notes" FontSize="19"
                         FontWeight="Bold" Margin="0,0,0,14"/>
              <TextBox x:Name="FullBioEditor" Style="{StaticResource FormTextBox}"
                       AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                       VerticalScrollBarVisibility="Auto" TextChanged="FullBioEditor_TextChanged"/>
            </DockPanel>
          </Border>
        </Grid>
      </Grid>
      <!-- Relationship records are managed separately from generic existing-record editing. -->
      <Grid x:Name="RelationshipsWorkspace" Grid.Column="1" Grid.ColumnSpan="2"
            Visibility="Collapsed" Margin="10,10,11,10"/>

      <!-- Real world/company year-end awards, with verified-field editing. -->
      <Grid x:Name="AwardsWorkspace" Grid.Column="1" Grid.ColumnSpan="2"
            Visibility="Collapsed" Margin="10,10,11,10"/>

      <!-- Read-only cross-record diagnostics and maintenance shortcuts. -->
      <Grid x:Name="ToolsWorkspace" Grid.Column="1" Grid.ColumnSpan="2"
            Visibility="Collapsed" Margin="10,10,11,10"/>

      <!-- Existing-record editor for companies, titles, events, and stables.
           All fields are bound to allowlisted existing MDB records. -->
      <Grid x:Name="ExistingWorkspace" Grid.Column="1" Grid.ColumnSpan="2"
            Visibility="Collapsed" Margin="10,10,11,10">
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="335"/>
        <ColumnDefinition Width="*"/>
       </Grid.ColumnDefinitions>

       <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,9,0">
        <DockPanel Margin="14">
         <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
          <TextBlock x:Name="ExistingListTitle" Text="Existing Records"
                     FontSize="22" FontWeight="Bold" Margin="2,2,0,9"/>
          <TextBlock Text="Reuse existing records. IDs are preserved."
                     Foreground="{StaticResource TextBrushMuted}"
                     FontSize="12" TextWrapping="Wrap" Margin="2,0,0,13"/>
          <TextBox x:Name="ExistingSearch" Style="{StaticResource SearchBox}"
                   TextChanged="ExistingSearch_TextChanged"
                   ToolTip="Search existing records by name or ID"/>
          <TextBlock x:Name="ExistingCount" Foreground="{StaticResource TextBrushMuted}"
                     Text="No records loaded" FontSize="12" Margin="2,12,0,0"/>
          <Button x:Name="CreateTagTeamButton" Content="+ Create Tag Team"
                  Style="{StaticResource BlueButton}" Visibility="Collapsed"
                  Click="CreateTagTeam_Click" Padding="12,9" Margin="0,15,0,0"
                  HorizontalAlignment="Stretch"/>
         </StackPanel>
         <ListBox x:Name="ExistingList" BorderThickness="0" Background="Transparent"
                  SelectionChanged="ExistingList_SelectionChanged"
                  VirtualizingStackPanel.IsVirtualizing="True"
                  VirtualizingStackPanel.VirtualizationMode="Recycling">
          <ListBox.ItemTemplate>
           <DataTemplate>
            <StackPanel Margin="0,2">
             <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                        TextTrimming="CharacterEllipsis"/>
             <TextBlock Text="{Binding Id, StringFormat=Record ID {0}}"
                        FontSize="11" Foreground="#B1CAE8" Margin="0,4,0,0"/>
            </StackPanel>
           </DataTemplate>
          </ListBox.ItemTemplate>
         </ListBox>
        </DockPanel>
       </Border>

       <Grid Grid.Column="1">
        <Grid.RowDefinitions>
         <RowDefinition Height="154"/>
         <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="19"
                Margin="0,0,0,10" Background="#19334D">
         <StackPanel>
          <TextBlock x:Name="ExistingRecordTitle" Text="Select an existing record"
                     FontWeight="Bold" FontSize="25"
                     TextTrimming="CharacterEllipsis" Margin="0,0,0,7"/>
          <TextBlock x:Name="ExistingRecordSubtitle" Text="Record IDs and linked references are protected."
                     Foreground="#BED5ED" FontSize="13"/>
          <TextBlock Text="Save Changes writes directly to the active MDB. Create Backup is separate."
                     Foreground="#8FE0D5" FontSize="12" TextWrapping="Wrap"
                     Margin="0,18,0,0"/>
         </StackPanel>
        </Border>
        <Grid Grid.Row="1">
         <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
         </Grid.RowDefinitions>
         <StackPanel x:Name="TitleEditorTabs" Grid.Row="0" Orientation="Horizontal"
                     Visibility="Collapsed" Margin="0,0,0,10">
          <Button x:Name="TitleInfoTab" Content="Championship Details"
                  Style="{StaticResource BlueButton}" Click="TitleInfoTab_Click"
                  Margin="0,0,9,0" Padding="18,11"/>
          <Button x:Name="TitleLineageTab" Content="Title Lineage"
                  Style="{StaticResource ActionButton}" Click="TitleLineageTab_Click"
                  Padding="18,11" Margin="0,0,9,0"/>
          <Button x:Name="AdvancedLineageTab" Content="Advanced Generator"
                  Style="{StaticResource ActionButton}" Click="AdvancedLineageTab_Click"
                  Padding="18,11"/>
         </StackPanel>
         <Border x:Name="ExistingDetailsPanel" Grid.Row="1"
                 Style="{StaticResource CardBorder}" Padding="17">
          <DockPanel>
           <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBlock x:Name="ExistingFieldsTitle" Text="Editable Information"
                       FontSize="18" FontWeight="Bold"/>
            <TextBlock x:Name="ExistingFieldsDescription"
                       Text="Edit existing records. Primary keys and unverified links remain protected."
                       Foreground="{StaticResource TextBrushMuted}" FontSize="12"
                       TextWrapping="Wrap" Margin="0,6,0,0"/>
            <Border x:Name="TitleClassificationOptions" Visibility="Collapsed"
                    CornerRadius="8" Background="#19334D"
                    BorderBrush="#426080" BorderThickness="1"
                    Padding="12" Margin="0,14,0,0">
             <StackPanel>
              <TextBlock Text="TITLE CLASSIFICATION  ·  STUDIO ONLY"
                         Foreground="#EAF3FE" FontSize="14" FontWeight="SemiBold"/>
              <TextBlock Text="Organizational label saved in TEW Universe Studio, not in the TEW IX database."
                         Foreground="#ADCCE6" FontSize="12" Margin="0,5,0,7"
                         TextWrapping="Wrap"/>
              <WrapPanel Margin="0,2,0,4">
               <StackPanel Margin="0,0,14,0">
                <TextBlock Text="Record type" Foreground="#B9D4ED" FontSize="11" Margin="0,0,0,5"/>
                <ComboBox x:Name="TitleKindCombo" Style="{StaticResource DarkComboBox}"
                          Width="225" HorizontalAlignment="Left"
                          SelectionChanged="TitleKindCombo_SelectionChanged">
                 <ComboBoxItem Content="Championship" IsSelected="True"/>
                 <ComboBoxItem Content="Annual Tournament / Cup"/>
                </ComboBox>
               </StackPanel>
               <StackPanel>
                <TextBlock Text="Competitor format" Foreground="#B9D4ED" FontSize="11" Margin="0,0,0,5"/>
                <ComboBox x:Name="TitleCompetitorCombo" Style="{StaticResource DarkComboBox}"
                          Width="155" SelectionChanged="TitleCompetitorCombo_SelectionChanged">
                 <ComboBoxItem Content="Singles" IsSelected="True"/>
                 <ComboBoxItem Content="Tag Team"/>
                 <ComboBoxItem Content="Trios"/>
                </ComboBox>
               </StackPanel>
              </WrapPanel>
              <TextBlock x:Name="TitleClassificationHelp"
                         Text="Championship: ongoing reigns and defences."
                         Foreground="#87D9E0" FontSize="12"
                         TextWrapping="Wrap" Margin="0,7,0,0"/>
             </StackPanel>
            </Border>
           </StackPanel>
           <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ExistingFieldsPanel" Margin="0,0,12,12"/>
           </ScrollViewer>
          </DockPanel>
         </Border>
         <Border x:Name="TitleLineagePanel" Grid.Row="1" Visibility="Collapsed"
                 Style="{StaticResource CardBorder}" Padding="17">
          <DockPanel>
           <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBlock Text="Championship Lineage" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="Previous holders in tblBeltPreHistory, ordered by BeltOrder."
                       Foreground="{StaticResource TextBrushMuted}" FontSize="12"
                       TextWrapping="Wrap" Margin="0,6,0,7"/>
            <TextBlock x:Name="TitleLineageSummary" Text="Select a championship to view its lineage."
                       Foreground="#B9D4ED" FontSize="12" TextWrapping="Wrap"/>
            <WrapPanel Margin="0,10,0,0">
             <Button Content="Edit Selected Reign's Champions"
                     Style="{StaticResource BlueButton}"
                     Click="EditHistoricalReign_Click"
                     Margin="0,0,9,6" Padding="12,7"/>
             <Button Content="Insert Historical Reign"
                     Style="{StaticResource ActionButton}"
                     Click="InsertHistoricalReign_Click"
                     Margin="0,0,9,6" Padding="12,7"/>
            </WrapPanel>
            <TextBlock Text="Set linked wrestlers or name-only NPCs in singles, tag-team or trios history. No NPC worker is created. Editing champions preserves the reign; insertion adds one new chronological reign after a manual backup."
                       Foreground="#99B8D6" TextWrapping="Wrap" FontSize="11"
                       Margin="0,0,0,6"/>
            <WrapPanel Margin="0,10,0,0">
             <Button Content="Review / Repair This Title's Record Names"
                     Style="{StaticResource ActionButton}" Tag="Selected"
                     Click="ReviewExistingTitleRecordNames_Click"
                     Margin="0,0,9,6" Padding="12,7"/>
             <Button Content="Review / Repair All Title Record Names"
                     Style="{StaticResource ActionButton}" Tag="All"
                     Click="ReviewExistingTitleRecordNames_Click"
                     Margin="0,0,9,6" Padding="12,7"/>
            </WrapPanel>
            <TextBlock Text="Changes only existing Recordname text. All reign holders, dates, defenses, order numbers and UIDs are preserved. Review the changes and confirm before writing."
                       Foreground="#99B8D6" TextWrapping="Wrap" FontSize="11"
                       Margin="0,0,0,5"/>
            <Expander x:Name="LineageGeneratorOptions" Header="Generate Title Reigns"
                      Foreground="#EAF5FF" Margin="0,10,0,8"
                      Background="#172C46">
             <StackPanel Margin="12,10,12,12">
              <TextBlock Text="Enter existing worker names or #IDs, one per line. Reigns are selected at random from this pool."
                         Foreground="#B9D4ED" TextWrapping="Wrap" FontSize="12"/>
              <TextBox x:Name="LineageWorkerPool" Style="{StaticResource FormTextBox}"
                       Height="75" AcceptsReturn="True" TextWrapping="Wrap"
                       VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                       Margin="0,6,0,6"/>
              <StackPanel Orientation="Horizontal">
               <Button Content="Use Recorded Champions" Style="{StaticResource ActionButton}"
                       Click="UseRecordedChampions_Click" Padding="10,6" Margin="0,0,10,7"/>
               <TextBlock Text="Or type your own worker names from the database."
                          Foreground="#B3CCE8" VerticalAlignment="Center"
                          TextWrapping="Wrap" FontSize="11"/>
              </StackPanel>
              <WrapPanel Margin="0,3,0,8">
               <StackPanel Margin="0,0,13,5">
                <TextBlock Text="Reigns" FontSize="11" Foreground="#B9D4ED"/>
                <TextBox x:Name="LineageReignCount" Style="{StaticResource FormTextBox}"
                         Text="5" Width="75"/>
               </StackPanel>
               <StackPanel Margin="0,0,13,5">
                <TextBlock Text="Start year" FontSize="11" Foreground="#B9D4ED"/>
                <TextBox x:Name="LineageStartYear" Style="{StaticResource FormTextBox}"
                         Text="2000" Width="90"/>
               </StackPanel>
               <StackPanel Margin="0,0,13,5">
                <TextBlock Text="End year" FontSize="11" Foreground="#B9D4ED"/>
                <TextBox x:Name="LineageEndYear" Style="{StaticResource FormTextBox}"
                         Text="2020" Width="90"/>
               </StackPanel>
               <StackPanel Margin="0,0,13,5">
                <TextBlock Text="Champion type" FontSize="11" Foreground="#B9D4ED"/>
                <ComboBox x:Name="LineageTeamType" Style="{StaticResource DarkComboBox}"
                          Width="134">
                 <ComboBoxItem Content="Singles" IsSelected="True"/>
                 <ComboBoxItem Content="Tag team"/>
                </ComboBox>
               </StackPanel>
              </WrapPanel>
              <WrapPanel>
               <Button Content="Generate Preview" Style="{StaticResource BlueButton}"
                       Click="GenerateLineage_Click" Padding="12,9" Margin="0,0,8,7"/>
               <Button x:Name="ApplyGeneratedLineageButton" Content="Replace Existing Reigns"
                       Style="{StaticResource ActionButton}" IsEnabled="False"
                       Click="ApplyGeneratedLineage_Click" Margin="0,0,8,7"/>
               <Button x:Name="ExportGeneratedLineageButton" Content="Export Draft CSV"
                       Style="{StaticResource ActionButton}" IsEnabled="False"
                       Click="ExportGeneratedLineage_Click" Margin="0,0,8,7"/>
               <Button Content="Show Saved Lineage" Style="{StaticResource ActionButton}"
                       Click="ShowSavedLineage_Click" Margin="0,0,8,7"/>
              </WrapPanel>
              <TextBlock x:Name="GeneratorHelp" Foreground="#E9BB65" FontSize="12"
                         TextWrapping="Wrap" Text="Drafts are previews. Replacing requires exactly the number of already-existing history rows for this championship; no new MDB records are inserted."/>
             </StackPanel>
            </Expander>
           </StackPanel>
           <DataGrid x:Name="TitleLineageGrid" AutoGenerateColumns="True"
                     AutoGeneratingColumn="TitleLineageGrid_AutoGeneratingColumn"
                     IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                     CanUserReorderColumns="True" CanUserSortColumns="True"
                     SelectionMode="Single" HeadersVisibility="Column"
                     Background="#102238" Foreground="#E2EDF8"
                     BorderBrush="#3B5673" BorderThickness="1"
                     RowBackground="#142B45" AlternatingRowBackground="#193550"
                     HorizontalGridLinesBrush="#345372" VerticalGridLinesBrush="#345372"
                     ColumnHeaderHeight="35" RowHeight="30"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     MinColumnWidth="110">
            <DataGrid.ColumnHeaderStyle>
             <Style TargetType="DataGridColumnHeader">
              <Setter Property="Background" Value="#234263"/>
              <Setter Property="Foreground" Value="#FFFFFF"/>
              <Setter Property="FontSize" Value="12"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
              <Setter Property="BorderBrush" Value="#4D6987"/>
              <Setter Property="BorderThickness" Value="0,0,1,1"/>
              <Setter Property="Padding" Value="11,8"/>
              <Setter Property="HorizontalContentAlignment" Value="Left"/>
             </Style>
            </DataGrid.ColumnHeaderStyle>
           </DataGrid>
          </DockPanel>
         </Border>
         <!-- The advanced generator is a deliberate separate workflow. It can
              reference real worker UIDs or name-only historical champions. -->
         <Border x:Name="AdvancedLineagePanel" Grid.Row="1" Visibility="Collapsed"
                 Style="{StaticResource CardBorder}" Padding="16">
          <DockPanel>
           <ScrollViewer DockPanel.Dock="Top" MaxHeight="437"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
           <StackPanel Margin="0,0,8,10">
            <TextBlock Text="Build a Championship History" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="Build complete Singles, Tag Team or Trios championship histories. Linked champions keep their real worker UIDs; historical NPCs have name-only -1 holder IDs and never become roster workers."
                       Foreground="#ACC6E6" TextWrapping="Wrap" FontSize="12"
                       Margin="0,5,0,12"/>

            <!-- Explicit human/linked-worker section. No NPCs are shown here. -->
            <Border CornerRadius="8" Background="#193653"
                    BorderBrush="#3D6388" BorderThickness="1"
                    Padding="12" Margin="0,0,0,10">
             <StackPanel>
              <TextBlock Text="SUPERSTARS  ·  EXISTING WORKERS"
                         Foreground="#E8F5FF" FontSize="15" FontWeight="SemiBold"/>
              <TextBlock Text="Choose an existing worker and optional ring-name alias, OR type a name and click Add Name-Only to import that historical person without creating a worker. Import Name List accepts pasted names or TXT/CSV files. For each teammate: choose a wrestler and optionally type their ring-name alias, OR leave that wrestler dropdown empty and type a required NPC name. Set total reigns and known winning years, then generate."
                         Foreground="#ACC6E6" FontSize="12" TextWrapping="Wrap"
                         Margin="0,4,0,10"/>
              <WrapPanel Margin="0,0,0,9" Orientation="Horizontal">
               <StackPanel Width="240" Margin="0,0,8,6">
                <TextBlock Text="Champion 1: existing worker"
                           Foreground="#BCD7EF" FontSize="11" Margin="0,0,0,5"/>
                <ComboBox x:Name="AdvancedWorkerPicker"
                          Style="{StaticResource DarkComboBox}"
                          SelectionChanged="AdvancedPartnerSelectionChanged"
                          ToolTip="Choose an existing wrestler, or leave unselected to type a name-only champion."/>
               </StackPanel>
               <StackPanel x:Name="AdvancedPartner2PickerGroup" Width="220"
                           Margin="0,0,8,6" Visibility="Collapsed">
                <TextBlock Text="Partner 2: existing worker"
                           Foreground="#BCD7EF" FontSize="11" Margin="0,0,0,5"/>
                <ComboBox x:Name="AdvancedPartner2Picker"
                          Style="{StaticResource DarkComboBox}"
                          SelectionChanged="AdvancedPartnerSelectionChanged"
                          ToolTip="Choose a real wrestler, or leave empty and use the adjacent NPC name field."/>
               </StackPanel>
               <StackPanel x:Name="AdvancedPartner2NameGroup" Width="220"
                           Margin="0,0,8,6" Visibility="Collapsed">
                <TextBlock x:Name="AdvancedPartner2NameLabel"
                           Text="Partner 2: NPC name (if no worker selected)"
                           Foreground="#BCD7EF" FontSize="11" Margin="0,0,0,5"/>
                <TextBox x:Name="AdvancedPartner2NpcName"
                         Style="{StaticResource FormTextBox}"
                         ToolTip="No worker selected: required NPC name. Worker selected: optional ring-name alias."/>
               </StackPanel>
               <StackPanel x:Name="AdvancedPartner3PickerGroup" Width="220"
                           Margin="0,0,8,6" Visibility="Collapsed">
                <TextBlock Text="Partner 3: existing worker"
                           Foreground="#BCD7EF" FontSize="11" Margin="0,0,0,5"/>
                <ComboBox x:Name="AdvancedPartner3Picker"
                          Style="{StaticResource DarkComboBox}"
                          SelectionChanged="AdvancedPartnerSelectionChanged"
                          ToolTip="Choose a real wrestler, or leave empty and use the adjacent NPC name field."/>
               </StackPanel>
               <StackPanel x:Name="AdvancedPartner3NameGroup" Width="220"
                           Margin="0,0,8,6" Visibility="Collapsed">
                <TextBlock x:Name="AdvancedPartner3NameLabel"
                           Text="Partner 3: NPC name (if no worker selected)"
                           Foreground="#BCD7EF" FontSize="11" Margin="0,0,0,5"/>
                <TextBox x:Name="AdvancedPartner3NpcName"
                         Style="{StaticResource FormTextBox}"
                         ToolTip="No worker selected: required NPC name. Worker selected: optional ring-name alias."/>
               </StackPanel>
               <StackPanel Width="195" Margin="0,0,8,6">
                <TextBlock x:Name="AdvancedPrimaryNameLabel"
                           Text="Champion 1: name-only historical person"
                           Foreground="#BCD7EF" FontSize="11" Margin="0,0,0,5"/>
                <TextBox x:Name="AdvancedWorkerAlias"
                         Style="{StaticResource FormTextBox}"
                         ToolTip="With a selected first worker, this is their optional ring-name alias. Without a selected worker, type a historical name to add a name-only champion."/>
               </StackPanel>
               <StackPanel Margin="0,0,0,6">
                <TextBlock Text="Add champion / team" Foreground="#BCD7EF"
                           FontSize="11" Margin="0,0,0,5"/>
                <WrapPanel>
                 <Button Content="Add Linked Superstar" Style="{StaticResource ActionButton}"
                         Click="AdvancedAddWorker_Click" Padding="13,7" Margin="0,0,8,6"
                         ToolTip="Add the selected real wrestler and complete partners with their optional aliases"/>
                 <Button Content="Add Name-Only" Style="{StaticResource BlueButton}"
                         Click="AdvancedAddNamedChampion_Click" Padding="13,7" Margin="0,0,8,6"
                         ToolTip="Use the Champion 1 name as an NPC historical champion, regardless of the first worker dropdown"/>
                 <Button Content="Import Name List" Style="{StaticResource ActionButton}"
                         Click="AdvancedImportNames_Click" Padding="13,7" Margin="0,0,8,6"
                         ToolTip="Paste names or load .txt/.csv historical champions and full teams"/>
                </WrapPanel>
               </StackPanel>
              </WrapPanel>
              <DataGrid x:Name="AdvancedCandidatesGrid" AutoGenerateColumns="False"
                        Height="128" IsReadOnly="False" CanUserAddRows="False"
                        CanUserDeleteRows="False" CanUserResizeColumns="True"
                        BorderBrush="#426080" BorderThickness="1"
                        Background="#12263D" Foreground="#EDF6FF"
                        RowBackground="#142B45" AlternatingRowBackground="#1D3852"
                        ColumnHeaderHeight="29" RowHeight="29"
                        PreviewKeyDown="AdvancedCandidatesGrid_PreviewKeyDown"
                        CellEditEnding="AdvancedCandidatesGrid_CellEditEnding">
               <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                 <Setter Property="Background" Value="#234263"/>
                 <Setter Property="Foreground" Value="White"/>
                 <Setter Property="Padding" Value="8,5"/>
                 <Setter Property="FontWeight" Value="SemiBold"/>
                </Style>
               </DataGrid.ColumnHeaderStyle>
               <DataGrid.Columns>
                <DataGridTextColumn Header="Superstar / ring name"
                      Binding="{Binding DisplayName, UpdateSourceTrigger=LostFocus}"
                      Width="2*"/>
                <DataGridTextColumn Header="Worker ID (-1 NPC)" Binding="{Binding WorkerId}"
                      Width="128" IsReadOnly="True"/>
                <DataGridTextColumn x:Name="AdvancedPartner2Column" Header="Partner 2 UID (-1 NPC)"
                      Binding="{Binding Partner2Uid, UpdateSourceTrigger=LostFocus}"
                      Width="130" Visibility="Collapsed"/>
                <DataGridTextColumn x:Name="AdvancedPartner2NameColumn" Header="Partner 2 name"
                      Binding="{Binding Partner2Name, UpdateSourceTrigger=LostFocus}"
                      Width="145" Visibility="Collapsed"/>
                <DataGridTextColumn x:Name="AdvancedPartner3Column" Header="Partner 3 UID (-1 NPC)"
                      Binding="{Binding Partner3Uid, UpdateSourceTrigger=LostFocus}"
                      Width="130" Visibility="Collapsed"/>
                <DataGridTextColumn x:Name="AdvancedPartner3NameColumn" Header="Partner 3 name"
                      Binding="{Binding Partner3Name, UpdateSourceTrigger=LostFocus}"
                      Width="145" Visibility="Collapsed"/>
                <DataGridTextColumn Header="Active from" Binding="{Binding FirstYear, UpdateSourceTrigger=LostFocus}"
                      Width="96"/>
                <DataGridTextColumn Header="Active until" Binding="{Binding LastYear, UpdateSourceTrigger=LostFocus}"
                      Width="96"/>
                <DataGridTextColumn Header="Reigns" Binding="{Binding RequiredReigns, UpdateSourceTrigger=LostFocus}"
                      Width="72"/>
                <DataGridTextColumn Header="Years won (optional, repeats allowed)"
                      Binding="{Binding WinYears, UpdateSourceTrigger=LostFocus}"
                      Width="2*"/>
                <DataGridTextColumn Header="Reign lengths (optional)"
                      Binding="{Binding ReignLengths, UpdateSourceTrigger=LostFocus}"
                      Width="1.7*"/>
               </DataGrid.Columns>
              </DataGrid>
              <TextBlock Text="Reigns = total wins for the exact linked team. For a historical NPC partner in FULL-history mode, type the NPC name rather than selecting a worker (the saved UID is -1); safe placeholder replacement still requires linked workers. Winning years are optional: 2016, 2016 is allowed; 2011 with six reigns leaves five years automatic. Use a dash for an unknown earlier year, e.g. -, -, 2011. Reign lengths are independently optional: 719d = EXACT 719 days; 2y = two calendar years plus up to 90 days; 6m = six calendar months plus up to 30 days. To set only one tenure use -, -, 2y and leave the others blank or random. Annual Cup editions still require distinct known winning years."
                         FontSize="11" Foreground="#ADC9E8" TextWrapping="Wrap"
                         Margin="0,7,0,0"/>
               <CheckBox x:Name="AdvancedRespectTournamentDates"
                         Content="Schedule title wins after the wrestler's recorded tournament victories"
                         IsChecked="True" Margin="0,10,0,0"
                         Foreground="#E8F5FF" FontSize="12"
                         Checked="AdvancedChronologyChanged"
                         Unchecked="AdvancedChronologyChanged"
                         ToolTip="Uses other titles classified as Annual Tournament / Cup in this scenario. Matches existing worker UIDs and winning years."/>
               <TextBlock x:Name="AdvancedChronologyHelp"
                          Text="Matches linked workers by UID. Only tournament wins recorded in the same year constrain championship dates; this does not change existing history."
                          FontSize="11" Foreground="#ADC9E8" TextWrapping="Wrap"
                          Margin="20,4,0,0"/>
             </StackPanel>
            </Border>

            <!-- NPCs are generated invisibly from tblGenerateWorker. Only
                 their historical period and optional codes are user inputs. -->
            <Border CornerRadius="8" Background="#172E45"
                    BorderBrush="#3D6388" BorderThickness="1"
                    Padding="12" Margin="0,0,0,10">
             <StackPanel>
              <TextBlock Text="NPC HISTORY  ·  GENERATED NAMES"
                         Foreground="#E8F5FF" FontSize="15" FontWeight="SemiBold"/>
              <TextBlock x:Name="AdvancedNpcDescription"
                         Text="Set the history's start and end. Championships get varied reigns lasting weeks, months or longer. Annual tournaments get one winner per year. NPC names come from tblGenerateWorker."
                         Foreground="#ACC6E6" FontSize="12" TextWrapping="Wrap"
                         Margin="0,4,0,10"/>
              <WrapPanel>
               <StackPanel Margin="0,0,12,6">
                <TextBlock Text="Employment-check company" Foreground="#ADC9E8" FontSize="11"/>
                <ComboBox x:Name="AdvancedEmploymentCompany" Style="{StaticResource DarkComboBox}"
                          Width="245" SelectionChanged="AdvancedCalendarChanged"
                          ToolTip="Select the company used to verify whether champions were employed during their entire reign."/>
               </StackPanel>
               <StackPanel Margin="0,0,12,6">
                <TextBlock Text="From year" Foreground="#ADC9E8" FontSize="11"/>
                <TextBox x:Name="AdvancedStartYear" Style="{StaticResource FormTextBox}"
                         Text="1994" Width="92" TextChanged="AdvancedInputChanged" ToolTip="The championship's first historical year"/>
               </StackPanel>
               <StackPanel x:Name="ChampionshipStartMonthFields" Margin="0,0,12,6">
                <TextBlock Text="Starting month (optional)" Foreground="#ADC9E8" FontSize="11"/>
                <ComboBox x:Name="AdvancedStartMonth" Style="{StaticResource DarkComboBox}"
                          Width="160" SelectionChanged="AdvancedCalendarChanged"
                          ToolTip="Championship histories begin on a random day within the chosen month in the From year. Default month: January.">
                 <ComboBoxItem Content="Default (January)" IsSelected="True"/>
                 <ComboBoxItem Content="January"/>
                 <ComboBoxItem Content="February"/>
                 <ComboBoxItem Content="March"/>
                 <ComboBoxItem Content="April"/>
                 <ComboBoxItem Content="May"/>
                 <ComboBoxItem Content="June"/>
                 <ComboBoxItem Content="July"/>
                 <ComboBoxItem Content="August"/>
                 <ComboBoxItem Content="September"/>
                 <ComboBoxItem Content="October"/>
                 <ComboBoxItem Content="November"/>
                 <ComboBoxItem Content="December"/>
                </ComboBox>
               </StackPanel>
               <StackPanel Margin="0,0,12,6">
                <TextBlock Text="Through year" Foreground="#ADC9E8" FontSize="11"/>
                <TextBox x:Name="AdvancedEndYear" Style="{StaticResource FormTextBox}"
                         Text="2021" Width="92" TextChanged="AdvancedInputChanged" ToolTip="The championship's final historical year"/>
               </StackPanel>
               <StackPanel x:Name="AnnualTournamentDateFields" Orientation="Horizontal"
                           Visibility="Collapsed" Margin="0,0,12,6">
                <StackPanel Margin="0,0,8,0">
                 <TextBlock Text="Winning month" Foreground="#ADC9E8" FontSize="11"/>
                 <TextBox x:Name="AnnualTournamentMonth" Style="{StaticResource FormTextBox}"
                          Text="3" Width="100" TextChanged="AdvancedInputChanged"
                          ToolTip="Month of each annual event, 1–12"/>
                </StackPanel>
                <StackPanel Margin="0,0,8,0">
                 <TextBlock Text="Week of month" Foreground="#ADC9E8" FontSize="11"/>
                 <ComboBox x:Name="AnnualTournamentWeek" Style="{StaticResource DarkComboBox}"
                           Width="115" SelectionChanged="AdvancedCalendarChanged"
                           ToolTip="Which occurrence of the weekday in each year's selected month">
                  <ComboBoxItem Content="First" IsSelected="True"/>
                  <ComboBoxItem Content="Second"/>
                  <ComboBoxItem Content="Third"/>
                  <ComboBoxItem Content="Fourth"/>
                  <ComboBoxItem Content="Last"/>
                 </ComboBox>
                </StackPanel>
                <StackPanel>
                 <TextBlock Text="Weekday" Foreground="#ADC9E8" FontSize="11"/>
                 <ComboBox x:Name="AnnualTournamentWeekday" Style="{StaticResource DarkComboBox}"
                           Width="122" SelectionChanged="AdvancedCalendarChanged"
                           ToolTip="Winning date is calculated separately for each calendar year">
                  <ComboBoxItem Content="Sunday" IsSelected="True"/>
                  <ComboBoxItem Content="Monday"/>
                  <ComboBoxItem Content="Tuesday"/>
                  <ComboBoxItem Content="Wednesday"/>
                  <ComboBoxItem Content="Thursday"/>
                  <ComboBoxItem Content="Friday"/>
                  <ComboBoxItem Content="Saturday"/>
                 </ComboBox>
                </StackPanel>
               </StackPanel>
               <StackPanel Margin="0,0,12,6">
                <TextBlock Text="Gender code (optional)" Foreground="#ADC9E8" FontSize="11"/>
                <TextBox x:Name="AdvancedNpcGender" Style="{StaticResource FormTextBox}"
                         Width="110" TextChanged="AdvancedInputChanged" ToolTip="Blank includes every gender from tblGenerateWorker"/>
               </StackPanel>
               <StackPanel Margin="0,0,12,6">
                <TextBlock Text="Race code (optional)" Foreground="#ADC9E8" FontSize="11"/>
                <TextBox x:Name="AdvancedNpcRace" Style="{StaticResource FormTextBox}"
                         Width="110" TextChanged="AdvancedInputChanged" ToolTip="Blank includes every race from tblGenerateWorker"/>
               </StackPanel>
              </WrapPanel>
             </StackPanel>
            </Border>
            <StackPanel Margin="0,0,0,9">
             <TextBlock Text="Lineage operation" Foreground="#ACC6E6" FontSize="12"
                        Margin="0,0,0,5"/>
             <ComboBox x:Name="AdvancedGenerationMode" Width="460"
                       HorizontalAlignment="Left" Style="{StaticResource DarkComboBox}"
                       SelectionChanged="AdvancedCalendarChanged">
              <ComboBoxItem Content="Replace only name-only/unused reigns (preserve dates)" IsSelected="True"/>
              <ComboBoxItem Content="Build new full history (replaces existing lineage)"/>
             </ComboBox>
             <TextBlock Text="Safe replacement only fills existing slots, preserving dates. Full history can create new Singles, Tag Team or Trios histories, including name-only NPC lineups; it REPLACES all prior reigns for the selected title and REQUIRES a manual backup."
                        Foreground="#ADC9E8" FontSize="11" TextWrapping="Wrap"
                        Margin="0,5,0,0"/>
            </StackPanel>
            <WrapPanel Margin="0,0,0,6">
             <Button Content="Generate Preview" Style="{StaticResource BlueButton}"
                     Click="AdvancedGenerate_Click" Padding="13,9" Margin="0,0,8,6"/>
             <Button x:Name="AdvancedApplyButton" Content="Import Preview to Title Lineage"
                     IsEnabled="False" Style="{StaticResource ActionButton}"
                     Click="AdvancedApply_Click" Margin="0,0,8,6"/>
             <Button x:Name="AdvancedExportButton" Content="Export Draft CSV"
                     IsEnabled="False" Style="{StaticResource ActionButton}"
                     Click="AdvancedExport_Click" Margin="0,0,8,6"/>
             <Button Content="Clear Superstars" Style="{StaticResource ActionButton}"
                     Click="AdvancedClear_Click" Margin="0,0,8,6"/>
            </WrapPanel>
            <TextBlock x:Name="AdvancedGenerationStatus"
                       Text="Set the history range and fixed superstar victories. Tournament dates follow the selected weekday and week of each month."
                       Foreground="#E7C38D" TextWrapping="Wrap" FontSize="12"
                       Margin="0,0,0,5"/>
           </StackPanel>
          </ScrollViewer>
           <DataGrid x:Name="AdvancedPreviewGrid" AutoGenerateColumns="True"
                     AutoGeneratingColumn="TitleLineageGrid_AutoGeneratingColumn"
                     IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                     Background="#102238" Foreground="#EDF6FF"
                     RowBackground="#142B45" AlternatingRowBackground="#193550"
                     BorderBrush="#426080" BorderThickness="1"
                     HeadersVisibility="Column" ColumnHeaderHeight="34"
                     RowHeight="29" MinColumnWidth="110"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
            <DataGrid.ColumnHeaderStyle>
             <Style TargetType="DataGridColumnHeader">
              <Setter Property="Background" Value="#234263"/>
              <Setter Property="Foreground" Value="White"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
              <Setter Property="Padding" Value="9,7"/>
             </Style>
            </DataGrid.ColumnHeaderStyle>
           </DataGrid>
          </DockPanel>
         </Border>
        </Grid>
       </Grid>
      </Grid>
    </Grid>

    <Border Grid.Row="3" Background="#101B2B" BorderBrush="#30435B" BorderThickness="0,1,0,0">
      <Grid Margin="16,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusText" Text="Ready" Foreground="#65DEC3"
                   FontSize="12" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" x:Name="FilteredText" Text=""
                   Foreground="{StaticResource TextBrushMuted}" FontSize="12"
                   VerticalAlignment="Center" Margin="20,0"/>
        <TextBlock Grid.Column="2" x:Name="WorkingText" Text="No working copy"
                   Foreground="{StaticResource TextBrushMuted}" FontSize="12"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        <TextBlock Grid.Column="3" x:Name="SaveStateText" Text="No unsaved edits"
                   Foreground="#70E4C6" FontSize="12" VerticalAlignment="Center"/>
      </Grid>
    </Border>
  </Grid>
</Window>